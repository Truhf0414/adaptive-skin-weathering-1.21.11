{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "name": "${mod_name}",
  "version": "${version}",
  "description": "Unofficial Fabric 1.21.11 port of Adaptive Skin Weathering: dirt, sand, stone dust, snow and blood build up on player skins based on movement, surface, damage and biome.",
  "authors": [
    "Blagoslav",
    "Launt1m"
  ],
  "contributors": [
    "Truhf0414 (1.21.11 port)"
  ],
  "license": "LGPL-3.0-or-later",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.weathering.WeatheringMod"
    ],
    "client": [
      "com.example.weathering.WeatheringModClient"
    ],
    "modmenu": [
      "com.example.weathering.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "skin_weathering.mixins.json",
    {
      "config": "skin_weathering.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "cloth-config2": ">=21.11.153",
    "modmenu": ">=17.0.0"
  }
}
